      "licensePermission": "OFL-1.1",
      "attribution": "Preserve the package OFL-1.1 license notice and Sofia Sans Project attribution.",
      "permittedUse": "BUNDLED_SELF_HOSTED_WEB_FONT",
      "privacyClass": "PUBLIC_NON_PERSONAL",
      "distributionScope": "SHIPPED_RUNTIME",
      "releaseDisposition": "ADMITTED",
      "blockers": []
    }
  ],
  "packageIconSet": {
    "kind": "package-icon-set",
    "locator": "npm:@phosphor-icons/react@2.1.10#imported-svg-icons",
    "dependencyId": "npm:@phosphor-icons/react@2.1.10",
    "importSpecifier": "@phosphor-icons/react",
    "scanRoots": ["apps/web/src", "packages"],
    "installedDefinitions": "apps/web/node_modules/@phosphor-icons/react/dist/defs/{name}.es.js",
    "creator": "Phosphor Icons",
    "provenance": "Exact @phosphor-icons/react package bound by the dependency inventory; only statically imported glyph definitions are shipped.",
    "licensePermission": "MIT",
