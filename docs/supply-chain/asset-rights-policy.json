      "licensePermission": "OFL-1.1",
      "attribution": "Preserve the package OFL-1.1 license notice and Cormorant Project attribution.",
      "permittedUse": "BUNDLED_SELF_HOSTED_WEB_FONT",
      "privacyClass": "PUBLIC_NON_PERSONAL",
      "distributionScope": "SHIPPED_RUNTIME",
      "releaseDisposition": "ADMITTED",
      "blockers": []
    },
    {
      "kind": "package-font",
      "locator": "npm:@fontsource-variable/sofia-sans@5.3.0#files/sofia-sans-latin-wght-normal.woff2",
      "dependencyId": "npm:@fontsource-variable/sofia-sans@5.3.0",
      "installedPath": "apps/web/node_modules/@fontsource-variable/sofia-sans/files/sofia-sans-latin-wght-normal.woff2",
      "creator": "The Sofia Sans Project Authors",
