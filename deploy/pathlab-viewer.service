[Unit]
Description=PathLab Viewer container stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pathlab-viewer/deploy
ExecStart=/bin/bash /opt/pathlab-viewer/deploy/scripts/compose-pathlab.sh up -d --build --remove-orphans
ExecReload=/bin/bash /opt/pathlab-viewer/deploy/scripts/compose-pathlab.sh up -d --build --remove-orphans
ExecStop=/bin/bash /opt/pathlab-viewer/deploy/scripts/compose-pathlab.sh down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
