DOMAIN=your-subdomain.duckdns.org
ACME_EMAIL=you@example.com
PATHLAB_SECRET_KEY=generate-with-openssl-rand-hex-32
PATHLAB_DATA_DIR=/srv/pathlab/data
PATHLAB_LIBVIPS_CONCURRENCY=1
PATHLAB_LIBVIPS_CACHE_MAX_MEM_BYTES=268435456
PATHLAB_LIBVIPS_CACHE_MAX_FILES=128
PATHLAB_LIBVIPS_CACHE_MAX_OPERATIONS=100
PATHLAB_TILE_CACHE_MAX_BYTES=2147483648
PATHLAB_TILE_CACHE_LOW_WATER_BYTES=1879048192
PATHLAB_TILE_CACHE_MEMORY_BYTES=268435456
PATHLAB_TILE_RENDER_CONCURRENCY=2
PATHLAB_MULTI_SHARE_ENABLED=true
PATHLAB_ANNOTATIONS_ENABLED=false
PATHLAB_PRODUCTION_CLASSROOM_ENABLED=false
PATHLAB_CLASSROOM_SINGLETON=true
PATHLAB_CLASSROOM_MAX_PARTICIPANTS=300
PATHLAB_STUDY_MODE_ENABLED=false
PATHLAB_STUDY_COACH_AI_ENABLED=false
PATHLAB_STUDY_MAX_LEARNERS=500
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=replace-me
