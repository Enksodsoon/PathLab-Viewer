  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build --config vite.config.ts --manifest && node scripts/copy-release-legal-files.mjs",
    "check:annotation-bundle": "node scripts/check-annotation-bundle-budget.mjs",
    "check:assessment-bundle": "node scripts/check-assessment-bundle-budget.mjs",
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "onnxruntime-web": "1.27.0",
    "openseadragon": "6.1.0",
    "polygon-clipping": "0.15.7",
    "qrcode.react": "4.2.0",
    "rbush": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tus-js-client": "4.3.1",
    "read-excel-file": "6.0.1",
    "write-excel-file": "2.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
