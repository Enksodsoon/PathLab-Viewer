[Unit]
Description=PathLab Viewer component watchdog
Requires=docker.service
After=docker.service pathlab-viewer.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/pathlab-viewer/deploy
ExecStart=/usr/bin/python3 /opt/pathlab-viewer/deploy/scripts/component_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pathlab-viewer-watchdog
TimeoutStartSec=120
