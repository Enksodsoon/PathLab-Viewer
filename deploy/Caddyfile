{
	email {$ACME_EMAIL}
	metrics
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; worker-src 'self' blob:"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	@internal_api path /api/v1/internal/*
	handle @internal_api {
		respond 404
	}

	@direct_dynamic path /_pathlab_ome/*
	handle @direct_dynamic {
		respond 404
	}

	@uploads path /api/v1/uploads/*
	handle @uploads {
		header Cache-Control "no-store"
		forward_auth api:8000 {
			uri /api/v1/internal/uploads/admission
		}
		reverse_proxy tusd:8080
	}

	@classroom_events path /api/v1/classroom/sessions/*/events /api/v1/admin/classroom/sessions/*/events
	handle @classroom_events {
		header Cache-Control "no-store"
		reverse_proxy {$PATHLAB_CLASSROOM_SERVICE_URL} {
			flush_interval -1
		}
	}

	@classroom_api path /api/v1/classroom/* /api/v1/admin/classroom/*
	handle @classroom_api {
		header ?Cache-Control "no-store"
		reverse_proxy {$PATHLAB_CLASSROOM_SERVICE_URL}
	}

	@assessment_api path /api/v2/assessment/* /api/v2/admin/assessment/*
	handle @assessment_api {
		header ?Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		reverse_proxy {$PATHLAB_ASSESSMENT_SERVICE_URL}
	}

	@backend path /api/* /livez /readyz
	handle @backend {
		header ?Cache-Control "no-store"
		reverse_proxy api:8000 {
			@dynamic_delivery header X-Accel-Redirect /_pathlab_ome/*
			handle_response @dynamic_delivery {
				rewrite * {rp.header.X-Accel-Redirect}
				reverse_proxy tile-service:8090
			}
			@internal_delivery header X-Accel-Redirect *
			handle_response @internal_delivery {
				root * /
				rewrite * {rp.header.X-Accel-Redirect}
				header Cache-Control {rp.header.Cache-Control}
				method GET
				file_server
			}
		}
	}

	handle_path /tiles/* {
		root * /pathlab-individual
		header Cache-Control "private, max-age=86400, immutable"
		file_server
	}

	handle_path /assessment-assets/* {
		root * /pathlab-assessment
		header Cache-Control "private, max-age=86400, immutable"
		file_server
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
