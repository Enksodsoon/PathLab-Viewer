  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build --config vite.config.ts --manifest && node scripts/copy-release-legal-files.mjs",
    "check:annotation-bundle": "node scripts/check-annotation-bundle-budget.mjs",
    "check:assessment-bundle": "node scripts/check-assessment-bundle-budget.mjs",
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "onnxruntime-web": "1.29.0",
    "openseadragon": "6.1.1",
    "polygon-clipping": "0.15.7",
    "qrcode.react": "4.2.0",
    "rbush": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "tus-js-client": "4.3.1",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
