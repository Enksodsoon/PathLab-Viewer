PATHLAB_ENVIRONMENT=development
PATHLAB_DATABASE_URL=sqlite:////data/database/pathlab.sqlite3
PATHLAB_DATA_ROOT=/data
PATHLAB_SECRET_KEY=replace-with-at-least-32-random-bytes
PATHLAB_SECURE_COOKIES=true
PATHLAB_TUS_PUBLIC_URL=/api/v1/uploads/
PATHLAB_TUS_INTERNAL_UPLOAD_DIR=/data/tus
PATHLAB_MULTI_SHARE_ENABLED=true
PATHLAB_ANNOTATIONS_ENABLED=false
PATHLAB_CLASSROOM_ENABLED=false
PATHLAB_CLASSROOM_SINGLETON=false
PATHLAB_STUDY_MODE_ENABLED=false
PATHLAB_STUDY_COACH_AI_ENABLED=false
PATHLAB_STUDY_MAX_LEARNERS=500
