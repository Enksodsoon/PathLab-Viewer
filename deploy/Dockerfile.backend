FROM python:3.14.0-slim-bookworm@sha256:d13fa0424035d290decef3d575cea23d1b7d5952cdf429df8f5542c71e961576

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libvips42 libvips-tools \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md alembic.ini ./
COPY deploy/backend-requirements.txt ./deploy/backend-requirements.txt
COPY migrations ./migrations
COPY server ./server
RUN pip install --no-cache-dir --require-hashes -r deploy/backend-requirements.txt \
    && pip install --no-cache-dir --no-deps .
RUN python -c "from PIL import Image; import pyvips; import wsi_viewer.main, wsi_viewer.tile_service, wsi_viewer.worker; payload = pyvips.Image.black(1, 1, bands=3).jpegsave_buffer(Q=75, strip=True, optimize_coding=True); assert payload.startswith(b'\\xff\\xd8') and payload.endswith(b'\\xff\\xd9')"
RUN useradd --system --uid 10001 --create-home pathlab \
    && install -d -o pathlab -g pathlab -m 700 /cache/ome-tiles
USER pathlab
EXPOSE 8000
CMD ["uvicorn", "wsi_viewer.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips=*"]
